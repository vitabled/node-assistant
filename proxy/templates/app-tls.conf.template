# HTTPS: rendered once /etc/letsencrypt/live/${PROXY_DOMAIN}/ holds a certificate.
server {
    listen      80 default_server;
    listen      [::]:80 default_server;
    server_name ${PROXY_DOMAIN};

    server_tokens off;

    include /etc/nginx/snippets/headers.conf;
    # Keep the challenge path on HTTP — renewals depend on it (see acme.conf).
    include /etc/nginx/snippets/acme.conf;
    # …and keep /healthz answering here, or the container healthcheck follows the
    # 301 below into a certificate it cannot verify for 127.0.0.1.
    include /etc/nginx/snippets/healthz.conf;

    # ${REDIRECT_HOST} is `$host`, or `$host:<port>` when HTTPS is published on a
    # non-standard port — otherwise the browser would be sent to :443.
    location / {
        return 301 https://${REDIRECT_HOST}$request_uri;
    }
}

server {
    listen      443 ssl default_server;
    listen      [::]:443 ssl default_server;
    # ⚠️ HTTP/2 отключён намеренно: большой POST (архив до 50 МБ → тело ~67 МБ)
    # через HTTP/2 рвётся на середине у клиентов за VPN/провайдерами —
    # nginx видел `SSL_read() failed: bad record mac`, запрос уходил в 400,
    # фронт вечно висел на «Отправка». HTTP/1.1 передаёт большие тела
    # надёжнее (одно соединение = один запрос, нет мультиплексирования,
    # которое и ломается). SPA-нагрузка при этом не страдает заметно.
    # http2       on;
    server_name ${PROXY_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PROXY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PROXY_DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/headers.conf;
    include /etc/nginx/snippets/healthz.conf;
    include /etc/nginx/snippets/app.conf;
}
