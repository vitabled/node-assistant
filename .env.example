# Secret key: encrypts the infra-billing vault AND signs account session JWTs.
# MUST be changed — the default lets anyone forge a token for any account.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=change_me_32_hex_chars_minimum_here

# Max concurrent SSH sessions
MAX_SSH_SESSIONS=5

# Task log buffer size (lines kept in memory per task)
LOG_BUFFER_SIZE=2000

# CORS origin for frontend (change in production)
CORS_ORIGIN=http://localhost

# ── Reverse proxy / TLS ───────────────────────────────────────────
# Domain the panel is served on. Set it and the `proxy` container terminates TLS
# on :443 with a Let's Encrypt certificate (issued by install.sh, renewed by the
# `certbot` container). Leave EMPTY to serve plain HTTP on :80.
# Normally written by install.sh — see docs/deploy.md.
PROXY_DOMAIN=

# Contact address for Let's Encrypt expiry notices (optional).
ACME_EMAIL=

# Web entry ports published on the host by the `proxy` container.
# Change with: sudo node-assistant set-ports --http-port N --https-port N
# ⚠️ Let's Encrypt validates http-01 over PUBLIC port 80 — moving HTTP off 80
# means certificates cannot be issued automatically any more.
HTTP_PORT=80
HTTPS_PORT=443

# ── Optional service split (Plan M) ───────────────────────────────
# Where deploy tasks and their live logs are kept.
#   memory  (default) — in-process; single-container deployment.
#   shared            — SQLite under DATA_DIR; REQUIRED to hand deploys to the
#                       `deploy-worker` container, and harmless without it.
#
# To enable the split, UNCOMMENT the line below and then run:
#   docker compose --profile split up -d
# Starting the workers without it is not broken, but the deploy-worker will idle
# forever (gateway and worker would share no queue) — /api/health says so.
# TASK_STORE=shared

# Shared secret guarding /internal/agg-subs and the aggregator's /refresh.
# Empty disables the guard (dev only) — set a strong value in production.
# AGG_TOKEN=
